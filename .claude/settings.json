{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(pytest*)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(git status)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-protected-branch.sh" },
          { "type": "command", "command": ".claude/hooks/block-secret-exposure.sh" }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/block-secret-exposure.sh" }
        ]
      }
    ]
  }
}
